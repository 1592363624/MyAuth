NODE_ENV=production
VUE_APP_PREVIEW=false
#项目名
VUE_APP_ProjectName=MyAuth
#项目版本号
VUE_APP_ProjectVersion=1.1.5
#首页路径
VUE_APP_DesktopPath=/Home/Introduce
#发布后接口根地址
VUE_APP_PublishRootUrl=http://localhost:8081
#本地调试接口根地址
VUE_APP_LocalRootUrl=http://localhost:8081
#接口超时时间ms
VUE_APP_ApiTimeout=30000
#本地开发启动端口
VUE_APP_DevPort=8001
#备案号
VUE_APP_InternetContentProvider=浙ICP备000001号-1(伪)
#版权
VUE_APP_Copyright=2026  |  By Shell
#login页面slogan
VUE_APP_Slogan=永远相信美好的事情即将发生
#数据看板自动刷新时间，单位ms，设置为0或负值时表示不自动刷新刷新
VUE_APP_BoardRefreshTime=5000