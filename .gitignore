# ---------- 操作系统/编辑器产生的垃圾文件 ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- IntelliJ IDEA（个人设置，无需共享） ----------
.idea/
*.iml
*.iml.bak

# ---------- VS Code（仅个人设置忽略，推荐配置需提交） ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------- Java / Maven（构建产物与本地配置） ----------
target/
*.class
*.log
.mvn/wrapper/maven-wrapper.jar

# ---------- 前端依赖与构建产物 ----------
node_modules/
dist/
dist-ssr/
*.local

# ---------- 真实密钥/环境变量（仅忽略含真实值的文件） ----------
# myauth-web/.env 仅含构建期默认/占位值（项目名、版本号、localhost 地址、伪备案号），
# 无真实敏感信息，且生产接口地址由运行时 serverConfig.json 覆盖，故需提交供 CI 构建使用。
# .env.preview 仍可能含本地预览真实值，继续忽略。
myauth-web/.env.preview

# ---------- 真实本地配置（含敏感数据，禁止入库，仅保留 .example 模板） ----------
# 本地开发时把真实数据库密码/邮箱授权码等写在下面两个文件，它们会被忽略、不提交；
# 模板文件 config/application.example.yml 与 serverConfig.example.json 需入库，故显式放行。
myauth/src/main/resources/config/application.yml
myauth-web/public/serverConfig.json

# ---------- 例外：以下以 . 开头的配置文件必须提交，强制放行 ----------
!.editorconfig
!.eslintrc.js
!tests/unit/.eslintrc.js
!.env.example
!.gitignore
# 强制提交配置模板文件（即使同名真实文件被忽略，模板仍需入库）
!myauth/src/main/resources/config/application.example.yml
!myauth-web/public/serverConfig.example.json
